    "lint": "eslint . --format stylish",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:server": "typedoc",
    "free-port:3000": "for /f \"tokens=5\" %i in ('netstat -aon ^| findstr :3000') do taskkill /PID %i /F",
    "free-port:4200": "for /f \"tokens=5\" %i in ('netstat -aon ^| findstr :4200') do taskkill /PID %i /F"
  },
